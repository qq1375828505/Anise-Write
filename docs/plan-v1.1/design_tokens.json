{
  "genre": "literary-publishing",
  "theme_name": "literary-publishing",
  "theme_file": "tokens/themes/literary-publishing.json",
  "tokens": {
    "$name": "literary-publishing",
    "$description": "现代文学出版风主题。暖白纸底、墨黑正文、衬线标题、低饱和深靛蓝强调色、细线与大留白；面向中文网文创作软件计划书，去陶土色、去中式文艺范。",
    "typography": {
      "fontFamily": {
        "heading": {
          "$type": "fontFamily",
          "$value": "Noto Serif SC, Source Han Serif SC, Songti SC, SimSun, serif"
        },
        "body": {
          "$type": "fontFamily",
          "$value": "SimSun, 宋体, serif"
        },
        "bodyLatin": {
          "$type": "fontFamily",
          "$value": "Times New Roman, Georgia, serif"
        },
        "data": {
          "$type": "fontFamily",
          "$value": "Times New Roman, Arial, sans-serif",
          "description": "数据展示字体"
        },
        "code": {
          "$type": "fontFamily",
          "$value": "Consolas, Source Code Pro, monospace"
        }
      },
      "fontSize": {
        "title": { "$type": "dimension", "$value": "28pt", "description": "报告主标题" },
        "subtitle": { "$type": "dimension", "$value": "18pt" },
        "h1": { "$type": "dimension", "$value": "20pt" },
        "coverTitle": { "$type": "dimension", "$value": "22pt", "description": "封面主标题" },
        "coverCategory": { "$type": "dimension", "$value": "14pt" },
        "sectionHeader": { "$type": "dimension", "$value": "13pt" },
        "h2": { "$type": "dimension", "$value": "11pt", "description": "小节" },
        "h3": { "$type": "dimension", "$value": "10pt" },
        "body": { "$type": "dimension", "$value": "9pt", "description": "正文" },
        "small": { "$type": "dimension", "$value": "8pt" },
        "tiny": { "$type": "dimension", "$value": "7pt" },
        "caption": { "$type": "dimension", "$value": "9pt" },
        "dataLabel": { "$type": "dimension", "$value": "10pt" }
      },
      "lineHeight": {
        "title": { "$type": "number", "$value": 1.3 },
        "body": { "$type": "number", "$value": 1.6 },
        "compact": { "$type": "number", "$value": 1.35 }
      },
      "fontWeight": {
        "heading": { "$type": "fontWeight", "$value": "600" },
        "body": { "$type": "fontWeight", "$value": "400" },
        "emphasis": { "$type": "fontWeight", "$value": "500" }
      }
    },
    "color": {
      "primary": { "$type": "color", "$value": "#3E5C76", "$description": "低饱和深靛蓝（强调色）" },
      "secondary": { "$type": "color", "$value": "#6E8697", "$description": "灰蓝辅助色" },
      "accent": { "$type": "color", "$value": "#3E5C76", "$description": "强调色（深靛蓝）" },
      "text": { "$type": "color", "$value": "#1F1E1C", "$description": "墨黑正文" },
      "textSecondary": { "$type": "color", "$value": "#6B6660", "$description": "暖灰辅助文字" },
      "heading": { "$type": "color", "$value": "#2B3A4A", "$description": "墨黑偏蓝标题" },
      "divider": { "$type": "color", "$value": "#E5E1D8", "$description": "暖灰细线" },
      "background": { "$type": "color", "$value": "#FFFFFF" },
      "surface": { "$type": "color", "$value": "#F5F2EA", "$description": "暖纸纹卡片/底纹" },
      "emphasis": { "$type": "color", "$value": "#9E4A4A", "$description": "数据强调（哑砖红）" },
      "dataViz": {
        "series1": { "$type": "color", "$value": "#3E5C76" },
        "series2": { "$type": "color", "$value": "#6E8697" },
        "series3": { "$type": "color", "$value": "#8A7B5C" },
        "series4": { "$type": "color", "$value": "#9E4A4A" },
        "series5": { "$type": "color", "$value": "#4A6B52" },
        "series6": { "$type": "color", "$value": "#7B6B8A" }
      }
    },
    "spacing": {
      "paragraph": { "$type": "dimension", "$value": "0.75em" },
      "paragraphAfter": { "$type": "dimension", "$value": "0.75em" },
      "indent": { "$type": "dimension", "$value": "2em", "description": "文学出版风保留首行缩进" },
      "sectionGap": { "$type": "dimension", "$value": "2.5em" },
      "cardPadding": { "$type": "dimension", "$value": "1.5em" }
    },
    "layout": {
      "marginTop": { "$type": "dimension", "$value": "2.5cm" },
      "marginBottom": { "$type": "dimension", "$value": "2.0cm" },
      "marginLeft": { "$type": "dimension", "$value": "2.5cm" },
      "marginRight": { "$type": "dimension", "$value": "2.5cm" },
      "pageSize": { "$type": "string", "$value": "A4" },
      "maxContentWidth": { "$type": "dimension", "$value": "160mm" }
    },
    "decoration": {
      "headingBorderLeft": { "$type": "boolean", "$value": true, "$description": "标题左侧彩色竖线" },
      "headingBorderWidth": { "$type": "dimension", "$value": "4px" },
      "cardShadow": { "$type": "string", "$value": "none", "$description": "出版风不用投影，用细线" },
      "dividerStyle": { "$type": "string", "$value": "solid" }
    }
  },
  "typography_rules": null,
  "css_variables": {
    "--typography-fontFamily-heading": "Noto Serif SC, Source Han Serif SC, Songti SC, SimSun, serif",
    "--typography-fontFamily-body": "SimSun, 宋体, serif",
    "--typography-fontFamily-bodyLatin": "Times New Roman, Georgia, serif",
    "--typography-fontFamily-data": "Times New Roman, Arial, sans-serif",
    "--typography-fontFamily-code": "Consolas, Source Code Pro, monospace",
    "--typography-fontSize-title": "28pt",
    "--typography-fontSize-subtitle": "18pt",
    "--typography-fontSize-h1": "20pt",
    "--typography-fontSize-coverTitle": "22pt",
    "--typography-fontSize-coverCategory": "14pt",
    "--typography-fontSize-sectionHeader": "13pt",
    "--typography-fontSize-h2": "11pt",
    "--typography-fontSize-h3": "10pt",
    "--typography-fontSize-body": "9pt",
    "--typography-fontSize-small": "8pt",
    "--typography-fontSize-tiny": "7pt",
    "--typography-fontSize-caption": "9pt",
    "--typography-fontSize-dataLabel": "10pt",
    "--typography-lineHeight-title": "1.3",
    "--typography-lineHeight-body": "1.6",
    "--typography-lineHeight-compact": "1.35",
    "--typography-fontWeight-heading": "600",
    "--typography-fontWeight-body": "400",
    "--typography-fontWeight-emphasis": "500",
    "--color-primary": "#3E5C76",
    "--color-secondary": "#6E8697",
    "--color-accent": "#3E5C76",
    "--color-text": "#1F1E1C",
    "--color-textSecondary": "#6B6660",
    "--color-heading": "#2B3A4A",
    "--color-divider": "#E5E1D8",
    "--color-background": "#FFFFFF",
    "--color-surface": "#F5F2EA",
    "--color-emphasis": "#9E4A4A",
    "--color-dataViz-series1": "#3E5C76",
    "--color-dataViz-series2": "#6E8697",
    "--color-dataViz-series3": "#8A7B5C",
    "--color-dataViz-series4": "#9E4A4A",
    "--color-dataViz-series5": "#4A6B52",
    "--color-dataViz-series6": "#7B6B8A",
    "--spacing-paragraph": "0.75em",
    "--spacing-paragraphAfter": "0.75em",
    "--spacing-indent": "2em",
    "--spacing-sectionGap": "2.5em",
    "--spacing-cardPadding": "1.5em",
    "--layout-marginTop": "2.5cm",
    "--layout-marginBottom": "2.0cm",
    "--layout-marginLeft": "2.5cm",
    "--layout-marginRight": "2.5cm",
    "--layout-pageSize": "A4",
    "--layout-maxContentWidth": "160mm"
  }
}
